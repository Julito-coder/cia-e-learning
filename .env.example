# Supabase — projet CIA E-Learning
# Récupérer ces valeurs dans Supabase Dashboard → Project Settings → API
# La clé "publishable_key" (alias anon_key) est conçue pour être exposée côté client.
# Ne JAMAIS committer un fichier .env contenant une clé service_role.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
